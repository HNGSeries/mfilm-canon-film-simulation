+// http://www.magiclantern.fm/forum/index.php?topic=9673.msg171969#msg171969
+#define EFIC_CELSIUS (MOD(efic_temp - 95, 256) * 40 / 100 - 22) // assume same as EOSM until it can be tested in camera
