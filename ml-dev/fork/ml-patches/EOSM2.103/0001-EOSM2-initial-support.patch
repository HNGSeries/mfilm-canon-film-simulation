diff --git a/platform/EOSM2.103/Makefile b/platform/EOSM2.103/Makefile
new file mode 100644
index 000000000..07d69777c
--- /dev/null
+++ b/platform/EOSM2.103/Makefile
@@ -0,0 +1,26 @@
+MODEL = EOSM2
+FW_VERSION = 103
+
+TOP_DIR = ../..
+
+AUTOEXEC_BASE = 0x800000
+FIR_BASE = 0x800120
+
+#CANON_FIR = EOSM2103.FIR
+MAIN_FIRMWARE_ADDR = 0xFF0C0000
+ROMBASEADDR = 0xFF0C0000
+PLATFORM_ARCH = armv5te
+
+# Load ML at the beginning of the AllocateMemory pool
+# default 0x44C000 - 0xC2A000, patched to 0x4E0000 - 0xC2A000 (592K for us).
+RESTARTSTART = 0x44C100
+ML_BOOT_OBJ = boot-d45-am.o
+ML_SRC_EXTRA_OBJS = $(BUILD_DIR)/reloc.o
+
+ML_AF_PATTERNS_OBJ = n
+
+# Strict FAT32 8.3 short filename (DryOS FIO rejects 9-char "EOSM2_103")
+ML_MODULES_SYM_NAME = EOSM2103.SYM
+
+include ../Makefile
+.DEFAULT_GOAL := $(BUILD_DIR)/cam_complete
diff --git a/platform/EOSM2.103/cfn.c b/platform/EOSM2.103/cfn.c
new file mode 100644
index 000000000..1b84e6413
--- /dev/null
+++ b/platform/EOSM2.103/cfn.c
@@ -0,0 +1,37 @@
+#include <dryos.h>
+#include <property.h>
+#include <cfn-generic.h>
+
+// look on camera menu or review sites to get custom function numbers
+
+int get_htp() // Highlight Tone Priority
+{ 
+    return GetCFnData(0, 3);
+}
+
+void set_htp(int value)
+{
+    SetCFnData(0, 3, value); 
+}
+
+int get_mlu() // EOSM2 doesn't have mirror lock up
+{
+    return 0; 
+}
+
+void set_mlu(int value) 
+{ 
+    return;
+}
+
+int cfn_get_af_button_assignment() 
+{
+    return GetCFnData(0, 5);
+}
+
+void cfn_set_af_button(int value) 
+{
+    SetCFnData(0, 5, value);
+}
+
+GENERIC_GET_ALO
