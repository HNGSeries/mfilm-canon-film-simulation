# shell scripts run inside WSL: keep LF line endings
*.sh text eol=lf
*.py text eol=lf
*.c  text eol=lf
*.h  text eol=lf
*.patch text eol=lf
Makefile text eol=lf
# checksum lists are read line by line: keep LF
*.sha256 text eol=lf
# the colour tables rendered from spektrafilm are bytes: never touch their line ends
*.tab binary
